# Copia este archivo como .env (no se sube a git) y completa los valores.

# --- MLflow en DagsHub (experimentos) ---
# https://dagshub.com/<usuario>/<repositorio>.mlflow
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
# token de DagsHub (Settings > Tokens); es un secreto
MLFLOW_TRACKING_PASSWORD=

# --- Hugging Face (publicar modelos) ---
# Se usa la sesion de `hf auth login`. En Vercel, HF_TOKEN (solo lectura) solo hace falta si el repositorio
# de modelos es privado; se configura como variable de entorno del proyecto, nunca en el frontend.
HF_TOKEN=

# --- Frontend (web/.env) ---
# VITE_API_BASE_URL es publica (va al navegador). Vacia = misma URL de Vercel.
